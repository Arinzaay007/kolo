# ─── Walrus Memory ────────────────────────────────────────────────────────────
# Create the agent at https://memory.walrus.xyz/dashboard
# The delegate PUBLIC key there is the MEMWAL_AGENT_ID you paste on the submission form.
# Writes on the hosted relayer are SPONSORED: you pay no SUI and no WAL.
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=kolo

# ─── Tatum ────────────────────────────────────────────────────────────────────
# https://dashboard.tatum.io — the account ID there goes on the submission form.
# Without a key the gateway rate-limits after roughly one call (HTTP 429).
TATUM_API_KEY=
TATUM_SUI_GRPC_HOST=sui-mainnet-grpc.gateway.tatum.io

# ─── real funds (optional, but this is what makes the demo real) ─────────────
# Real Sui Mainnet addresses. Each is 0x + 64 hex characters.
# Leave unset to keep the seeded placeholders; set them and every claim check
# verifies against the chain for real. A malformed value STOPS the run.
KOLO_ADDR_ADA=
KOLO_ADDR_EMEKA=
KOLO_ADDR_TUNDE=
KOLO_ADDR_NGOZI=
KOLO_ADDR_BOLA=

# Who receives this round. Their KOLO_ADDR_* is the address a claim is checked against.
KOLO_COLLECTOR_MEMBER=Emeka

# Coin and amount. SUI has 9 decimals, USDC has 6 — they are not interchangeable.
# 0.001 SUI = 1000000 · 0.01 SUI = 10000000 · 20 USDC = 20000000
KOLO_COIN_TYPE=0x2::sui::SUI
KOLO_CONTRIBUTION_BASE=1000000

# The window a contribution must land inside. Default: the last 7 days, ending now —
# which is what lets a transfer you make today verify instead of reading as stale.
KOLO_ROUND_DAYS=7
# KOLO_ROUND_START=2026-10-25T00:00:00Z
# KOLO_ROUND_END=2026-11-01T00:00:00Z

# ─── spike (optional fixtures) ───────────────────────────────────────────────
# A real digest and owner to read in `npm run spike`.
SPIKE_DIGEST=
SPIKE_OWNER=

# ─── x402 collector fee ──────────────────────────────────────────────────────
# The collector agent earns a fee per round it reconciles, settled in USDC on Sui.
# Facilitator: sui-facilitator.onrender.com (non-custodial, zero-fee).
# Check it still supports us before demoing: npm run x402:check
KOLO_X402_NETWORK=sui:mainnet
KOLO_X402_PAYEE_MEMBER=Emeka
